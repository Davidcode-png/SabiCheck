# SabiCheck backend environment variables (example).
# Copy to backend/.env for local development and set the same keys in Render.
# Never commit the real .env file.

# Application
ENVIRONMENT=local
DEBUG=true
SECRET_KEY=replace-with-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=5

# Database
# Local example:
DATABASE_URL_SYNC=postgresql://postgres:password@localhost:5432/sabicheck
DATABASE_URL_ASYNC=postgresql+asyncpg://postgres:password@localhost:5432/sabicheck

# Comma-separated list of allowed frontend origins (no trailing slash).
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Cloudinary (uploads need create/upload permission)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=sabicheck/organizations

# NAFDAC Greenbook sync
GREENBOOK_SYNC_ENABLED=true
GREENBOOK_SYNC_ON_STARTUP=false
