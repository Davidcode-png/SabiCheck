# SabiCheck backend environment variables (example).
# Copy to backend/.env for local development and set the same keys in Render.
# Never commit the real .env file.

# Application
ENVIRONMENT=local
DEBUG=true
SECRET_KEY=replace-with-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=5

# Database
# Local example:
DATABASE_URL_SYNC=postgresql://postgres:password@localhost:5432/sabicheck
DATABASE_URL_ASYNC=postgresql+asyncpg://postgres:password@localhost:5432/sabicheck

# Neon example (use the DIRECT host, without "-pooler"):
# DATABASE_URL_SYNC=postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/DBNAME?sslmode=require
# DATABASE_URL_ASYNC=postgresql+asyncpg://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/DBNAME?ssl=require

# Comma-separated list of allowed frontend origins (no trailing slash).
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Cloudinary (uploads need create/upload permission)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=sabicheck/organizations

# NAFDAC Greenbook sync
GREENBOOK_SYNC_ENABLED=true
GREENBOOK_SYNC_ON_STARTUP=false

# Gemini (consumer report triage and the workspace assistant).
# Get a key from Google AI Studio. Leave GEMINI_API_KEY empty to disable both.
# The primary model is tried first; fallbacks are tried in order when it is
# overloaded, times out, or is unavailable.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.1-flash
GEMINI_MODEL_COOLDOWN_SECONDS=60
GEMINI_TRIAGE_ENABLED=true
GEMINI_TRIAGE_TIMEOUT_SECONDS=20
# 0 disables thinking for faster, cheaper responses; -1 lets the model decide.
GEMINI_TRIAGE_THINKING_BUDGET=0
GEMINI_ASSISTANT_ENABLED=true
GEMINI_ASSISTANT_TIMEOUT_SECONDS=25
GEMINI_ASSISTANT_THINKING_BUDGET=0
